    {
      "id": "PULSE-V01",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "字体层级：实际文字角色采用 theme 的字号、行高与字体；项目例外写明对象和用途。"
    },
    {
      "id": "PULSE-V02",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "颜色角色：画布、表面、文字、已有状态与品牌角色按有效设计用色，已有文字区别保持可辨。"
    },
    {
      "id": "PULSE-V03",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "间距与密度：组件采用约定间距及内距，内容换行后仍完整可读。"
    },
    {
      "id": "PULSE-V04",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "边框与表面：轻边线、圆角及浮层阴影按组件角色一致使用。"
    },
    {
      "id": "PULSE-V05",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "图标：同类图标的尺寸、笔画、间距与展开方向一致，保留动作名称和操作区域。"
    },
    {
      "id": "PULSE-V06",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "标签值关联：标签、对应值及已有补充说明在分组、对齐和跨宽度重排后仍能正确对应。"
    },
    {
      "id": "PULSE-V07",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "操作回归：本次样式改变涉及的现有控件、导航、展开与返回仍可操作，焦点与状态可见。"
    },
    {
      "id": "PULSE-V08",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "既有意义保留：本次视觉调整没有隐藏、截断或重新强调内容而改变已有业务含义；基线语义问题单列，不自动整改或阻断纯风格任务。"
    },
    {
      "id": "PULSE-V09",
      "role": "visual-page",
      "kind": "manual",
      "source": "docs/design.md#effective-design",
      "description": "跨页一致性：适用页面及详情使用同一视觉规则，共享入口、具体例外与未核实范围有记录。"
    },
