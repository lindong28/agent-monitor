run_export() {
  PYTHONPATH="$ROOT_DIR${PYTHONPATH:+:$PYTHONPATH}" "$AGENT_MONITOR_PYTHON" - "$@" <<'PY'
import argparse
import json
import sys

import exporter

parser = argparse.ArgumentParser(prog="agent-monitor export")
mode = parser.add_mutually_exclusive_group(required=True)
mode.add_argument("--out", help="create an export bundle directory")
mode.add_argument("--quota-only", action="store_true", help="refresh quota without exporting statistics")
mode.add_argument(
    "--version",
    action="store_true",
    help="print the exporter commit without reading or refreshing rollup state",
)
parser.add_argument("--cached-quota", action="store_true", help="collect statistics without actively querying provider Quota")
parser.add_argument("--gui-quota", action="store_true", help=argparse.SUPPRESS)
args = parser.parse_args()

try:
    if args.version:
        print(exporter.exporter_version())
    elif args.quota_only:
        print(json.dumps(exporter.export_quota(gui_quota=args.gui_quota), sort_keys=True))
    else:
        manifest = exporter.export_bundle(output_path=args.out, quota_refresh=not args.cached_quota, gui_quota=args.gui_quota)
        print(json.dumps(manifest, sort_keys=True))
except exporter.ExportError as exc:
    print("Export refused: %s" % exc, file=sys.stderr)
    raise SystemExit(2)
PY
}

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    if [ "$("$AGENT_MONITOR_PYTHON" "$ROOT_DIR/hub.py" role)" = hub ]; then
      "$AGENT_MONITOR_PYTHON" "$ROOT_DIR/hub.py" stop-web && "$AGENT_MONITOR_PYTHON" "$ROOT_DIR/hub.py" install-web
      exit $?
    fi
    stop >/dev/null || true
    start
    ;;
  status)
    status
    ;;
  open)
    open_dashboard
    ;;
  network)
    shift
    run_network "$@"
    ;;
  export)
    shift
    run_export "$@"
    ;;
  machines)
    shift
    case "${1:-}" in
      retire)
        shift
        run_machine_retire "$@"
        ;;
      accept)
        shift
        run_machine_accept "$@"
        ;;
      *)
        echo "unknown machines command: ${1:-}" >&2
        usage >&2
        exit 2
        ;;
    esac
    ;;
  refresh)
    if [ -n "$("$AGENT_MONITOR_PYTHON" "$ROOT_DIR/hub.py" url)" ] || is_running; then
      PYTHONPATH="$ROOT_DIR" "$AGENT_MONITOR_PYTHON" "$ROOT_DIR/refresh.py"
    else
      run_rollup
      echo "agent-monitor refresh: partial — local rollup finished; dashboard is stopped, so cross-machine data and Quota were not refreshed. Run 'agent-monitor start', then 'agent-monitor refresh'." >&2
      exit 1
    fi
    ;;
  collect)
    PYTHONPATH="$ROOT_DIR" "$AGENT_MONITOR_PYTHON" "$ROOT_DIR/hub.py" collect
    ;;
  rollup)
    shift
    case "${1:-}" in
      "")
        run_rollup
        ;;
      --check)
        shift
        run_rollup_check "$@"
        ;;
      adopt-timezone)
        shift
        run_rollup_adopt_timezone "$@"
        ;;
      blockers|recover|recover-reviewed|-h|--help)
        run_rollup_identity "$@"
        ;;
      *)
        echo "unknown rollup command: $1" >&2
        run_rollup_identity --help >&2
        exit 2
        ;;
    esac
    ;;
  *)
    usage
    exit 2
    ;;
esac
